{
  "openapi": "3.0.1",
  "info": {
    "title": "asp.net-service",
    "version": "1.0"
  },
  "paths": {
    "/api/market/eth/getLatestUsdPrice": {
      "get": {
        "tags": [
          "MarketData"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/market/eth/getAvgPriceChange": {
      "get": {
        "tags": [
          "MarketData"
        ],
        "parameters": [
          {
            "name": "time",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-span"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tokens/get": {
      "get": {
        "tags": [
          "Tokens"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tokens/get/{symbol}": {
      "get": {
        "tags": [
          "Tokens"
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tokens/add": {
      "post": {
        "tags": [
          "Tokens"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTokenRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTokenRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddTokenRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "symbol": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}